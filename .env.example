# Connection string for PostgreSQL (with the pgvector extension for production use)
DATABASE_URL=postgresql://docpipe:docpipe@localhost:5432/docpipe

# auto = use pgvector if the extension is available, otherwise fall back to real[] arrays
# pgvector = require pgvector (fail if missing)  |  array = always use real[]
VECTOR_BACKEND=auto

# hashing = deterministic, offline embedder (default, no model download)
# sentence-transformers = all-MiniLM-L6-v2 (pip install ".[models]")
EMBEDDER=hashing

# Chunking (sizes in words, a close approximation of tokens for English text)
CHUNK_SIZE=200
CHUNK_OVERLAP=40

# Data-quality thresholds
MIN_DOC_CHARS=50
MIN_CHARS_PER_PDF_PAGE=20

# Retention: documents are purged this many days after ingestion (docpipe purge-expired)
RETENTION_DAYS=365
